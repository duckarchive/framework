{
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "components/**/*",
    "index.ts",
    "lib/**/*",
    "fonts.ts"
  ],
  "exclude": [
    "stories",
    ".storybook",
    "**/*.stories.tsx",
    "**/*.stories.ts"
  ]
}
