{
  "name": "@duckarchive/framework",
  "version": "2.2.5",
  "description": "Framework with shared components for duckarchive applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./components/*": "./components/*",
    "./lib/*": "./lib/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "nextjs",
    "shared",
    "components",
    "typescript"
  ],
  "author": {
    "name": "alexandrtovmach",
    "email": "alexandrtovmach@gmail.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "@heroui/react": "^3.2.2",
    "@types/react": "^19.1.8",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "^15.2.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.2",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.21",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "react-icons": "^5.5.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
